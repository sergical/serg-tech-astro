---
export const prerender = false;

import Layout from '../../layouts/Layout.astro';
import { listPosts } from '../../lib/posts';

const posts = await listPosts();
---

<Layout title="admin · sergiy dybskiy" pwa>
  <main class="max-w-[760px] mx-auto px-4 py-6 font-mono text-base">
    <div class="flex items-center gap-2 mb-6">
      <h1 class="font-semibold">posts</h1>
      <form method="post" action="/admin/new" class="ml-auto">
        <button
          type="submit"
          class="inline-flex items-center h-11 px-5 rounded-full bg-primary text-background"
        >
          new post
        </button>
      </form>
    </div>

    <ul>
      {posts.map((post) => (
        <li>
          <a
            href={`/admin/${post.id}`}
            class="flex flex-col gap-0.5 py-3 border-b border-muted min-h-[44px]"
          >
            <span class="text-foreground">{post.title || 'untitled'}</span>
            <span class="text-muted-foreground text-sm">
              [{post.status}] · {post.updated_at.slice(0, 10)}
            </span>
          </a>
        </li>
      ))}
    </ul>
  </main>
</Layout>
