---
export const prerender = false;

import { getLiveEntry } from 'astro:content';
import Footer from '../../components/Footer.astro';
import Header from '../../components/Header.astro';
import Layout from '../../layouts/Layout.astro';
import PostView from '../../components/PostView.astro';

const { slug } = Astro.params;
const { entry: post } = await getLiveEntry('posts', { slug: slug!, status: 'published' });

if (!post) {
  return new Response(null, { status: 404 });
}
---

<Layout title={`${post.data.title || 'untitled'} · sergiy dybskiy`}>
  <div class="min-h-screen font-mono p-4 flex items-center justify-center text-sm">
    <main class="max-w-[700px] w-full">
      <Header location="toronto, canada" />
      <a href="/" class="text-muted-foreground hover:text-foreground text-sm">home</a>

      <div class="mt-6 mb-8">
        <PostView
          title={post.data.title}
          date={post.data.publishedAt?.slice(0, 10) ?? null}
          html={post.rendered?.html ?? ''}
        />
      </div>

      <Footer />
    </main>
  </div>
</Layout>
