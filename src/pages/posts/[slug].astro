---
import { getCollection, type CollectionEntry } from 'astro:content';
import Layout from '@/layouts/Layout.astro';
import Header from '@/components/Header.astro';

export const prerender = true;

export async function getStaticPaths() {
  const posts = await getCollection('posts', ({ data }) => !data.draft);
  return posts.map((post: CollectionEntry<'posts'>) => ({
    params: { slug: post.slug },
    props: { post },
  }));
}

interface Props {
  post: CollectionEntry<'posts'>;
}

const { post } = Astro.props;
const { Content } = await post.render();
---

<Layout title={post.data.title}>
  <div class="min-h-screen font-mono p-4 flex flex-col text-sm">
    <main class="max-w-[700px] w-full mx-auto" transition:name="main-content">
      <Header location="toronto, canada" texts={['writing', 'posts', 'thoughts']} showLocation={false} />
      <article class="py-8">
        <header class="mb-8">
          <h1 class="text-3xl font-bold" transition:name={`post-title-${post.slug}`}>{post.data.title}</h1>
          <time class="text-sm text-[var(--muted)] block mt-2" transition:name={`post-date-${post.slug}`}>
            {post.data.date.toLocaleDateString('en-US', {
              year: 'numeric',
              month: 'long',
              day: 'numeric'
            })}
          </time>
          <p class="text-[var(--muted)] mt-2">{post.data.description}</p>
          {post.data.tags.length > 0 && (
            <div class="flex gap-2 mt-4">
              {post.data.tags.map((tag: string) => (
                <span class="text-xs px-2 py-1 bg-[var(--muted)]/10 rounded">
                  {tag}
                </span>
              ))}
            </div>
          )}
        </header>

        <div class="prose prose-neutral dark:prose-invert max-w-none">
          <Content />
        </div>
      </article>
    </main>
  </div>
</Layout>

<style is:global>
  .prose {
    line-height: 1.75;
  }
  .prose h1, .prose h2, .prose h3, .prose h4 {
    font-weight: 600;
    margin-top: 2em;
    margin-bottom: 0.5em;
  }
  .prose h1 { font-size: 2em; }
  .prose h2 { font-size: 1.5em; }
  .prose h3 { font-size: 1.25em; }
  .prose p {
    margin-bottom: 1.25em;
  }
  .prose ul, .prose ol {
    margin-bottom: 1.25em;
    padding-left: 1.5em;
  }
  .prose ul { list-style-type: disc; }
  .prose ol { list-style-type: decimal; }
  .prose li {
    margin-bottom: 0.5em;
  }
  .prose code {
    background-color: rgba(128, 128, 128, 0.2);
    padding: 0.2em 0.4em;
    border-radius: 0.25em;
    font-size: 0.875em;
  }
  .prose pre {
    background-color: rgba(128, 128, 128, 0.1);
    padding: 1em;
    border-radius: 0.5em;
    overflow-x: auto;
    margin-bottom: 1.25em;
  }
  .prose pre code {
    background: none;
    padding: 0;
  }
  .prose a {
    text-decoration: underline;
  }
  .prose a:hover {
    opacity: 0.8;
  }
  .prose blockquote {
    border-left: 3px solid var(--muted);
    padding-left: 1em;
    margin-left: 0;
    font-style: italic;
    opacity: 0.9;
  }
</style>
