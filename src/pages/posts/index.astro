---
import { getCollection, type CollectionEntry } from 'astro:content';
import Layout from '@/layouts/Layout.astro';
import Header from '@/components/Header.astro';
import Footer from '@/components/Footer.astro';

const posts = await getCollection('posts', ({ data }: CollectionEntry<'posts'>) => !data.draft);
const sortedPosts = posts.sort((a: CollectionEntry<'posts'>, b: CollectionEntry<'posts'>) => b.data.date.valueOf() - a.data.date.valueOf());
---

<Layout title="Posts">
  <div class="min-h-screen font-mono p-4 flex flex-col text-sm">
    <main class="max-w-[700px] w-full mx-auto">
      <Header location="toronto, canada" texts={['writing', 'posts', 'thoughts']} showLocation={false} />
      
      {sortedPosts.length === 0 ? (
        <p class="text-[var(--muted)]">No posts yet.</p>
      ) : (
        <ul class="space-y-8">
          {sortedPosts.map((post: CollectionEntry<'posts'>) => (
            <li>
              <a href={`/posts/${post.slug}`} class="block group">
                <time class="text-sm text-[var(--muted)] block" transition:name={`post-date-${post.slug}`}>
                  {post.data.date.toLocaleDateString('en-US', {
                    year: 'numeric',
                    month: 'long',
                    day: 'numeric'
                  })}
                </time>
                <h2 class="text-xl font-semibold mt-1 group-hover:underline" transition:name={`post-title-${post.slug}`}>
                  {post.data.title}
                </h2>
                <p class="text-[var(--muted)] mt-2" transition:name={`post-desc-${post.slug}`}>
                  {post.data.description}
                </p>
                {post.data.tags.length > 0 && (
                  <div class="flex gap-2 mt-3" transition:name={`post-tags-${post.slug}`}>
                    {post.data.tags.map((tag: string) => (
                      <span class="text-xs px-2 py-1 bg-[var(--muted)]/10 rounded">
                        {tag}
                      </span>
                    ))}
                  </div>
                )}
              </a>
            </li>
          ))}
        </ul>
      )}
      <Footer />
    </main>
  </div>
</Layout>
